  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#2f5f9a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#7c6bb8"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.separator"],
      "settings": {
        "foreground": "#6b7bc4"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#4a8ad4"
      }
    },
    {
      "name": "Types & classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e0c36c"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#dce6f5"
      }
    },
    {
      "name": "Constants & numbers",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#e0c36c"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#7c6bb8"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#6b7bc4"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#6b7bc4"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.block",
        "punctuation.definition.parameters"
      ],
      "settings": {
        "foreground": "#dce6f599"
      }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#7c6bb8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#4a8ad4"
      }
    },
    {
      "name": "Markdown bold / italic",
      "scope": ["markup.bold", "markup.italic"],
      "settings": {
        "foreground": "#e0c36c"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#f38ba8"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#6b7bc4",
    "class": "#e0c36c",
    "enum": "#e0c36c",
    "interface": "#e0c36c",
    "type": "#e0c36c",
    "typeParameter": "#e0c36c",
    "function": "#4a8ad4",
    "method": "#4a8ad4",
    "parameter": "#dce6f5",
    "variable": "#dce6f5",
    "property": "#6b7bc4",
    "enumMember": "#a6e3a1",
    "keyword": "#7c6bb8",
    "string": "#a6e3a1",
    "number": "#e0c36c",
    "comment": "#2f5f9a",
    "*.deprecated": {
      "foreground": "#dce6f566",
      "fontStyle": "strikethrough"
    },
    "*.unused": "#dce6f566"
  }
}
